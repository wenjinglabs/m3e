---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  lang: "en" | "zh";
  title: string;
  description?: string;
  /** 当前页路径，如 /components/button/ */
  path: string;
  /** 另一语言的对应路径 */
  altPath: string;
  activeId?: string;
  toc?: boolean;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  script?: string;
}

const {
  lang,
  title,
  description = "",
  path,
  altPath,
  activeId,
  toc = true,
  headings = [],
  script = "",
} = Astro.props;

const SECTIONS = {
  "getting-started": { en: "Getting Started", zh: "开始使用", icon: "rocket_launch" },
  styles: { en: "Styles", zh: "样式", icon: "palette" },
  frameworks: { en: "Frameworks", zh: "框架集成", icon: "integration_instructions" },
  components: { en: "Components", zh: "组件", icon: "widgets" },
} as const;

const UI = {
  en: { menu: "Menu", github: "GitHub repository", npm: "npm package", docs: "Docs" },
  zh: { menu: "菜单", github: "GitHub 仓库", npm: "npm 包", docs: "文档" },
}[lang];

const CATEGORY_ORDER = ["actions", "communication", "containment", "navigation", "selection", "basics"] as const;
const CATEGORY_LABELS = {
  actions: { en: "Actions", zh: "操作" },
  communication: { en: "Communication", zh: "通信" },
  containment: { en: "Containment", zh: "容器" },
  navigation: { en: "Navigation", zh: "导航" },
  selection: { en: "Selection", zh: "选择" },
  basics: { en: "Basics", zh: "基础" },
} as const;

function pathFor(id: string): string {
  const [, section, ...rest] = id.split("/");
  const prefix = lang === "zh" ? "" : `/${lang}`;
  return `${prefix}/${section}/${rest.join("/")}/`;
}

const all = await getCollection("docs");
const mine = all
  .filter((d) => d.id.startsWith(`${lang}/`))
  .map((d) => ({
    id: d.id,
    title: d.data.title,
    section: d.data.section,
    category: d.data.category,
    order: d.data.order,
    path: pathFor(d.id),
  }))
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

const active = mine.find((d) => d.id === activeId);
const SECTION_KEYS = ["getting-started", "styles", "frameworks", "components"];
const pathSegment = path.replace(/^\/en(?=\/|$)/, "").split("/").filter(Boolean)[0];
const currentSection = active?.section ?? (SECTION_KEYS.includes(pathSegment) ? pathSegment : "getting-started");

const isDetail = new RegExp("^/(en/)?components/[^/]+/$").test(path);
const showBottomNav = !isDetail;

const nav = (Object.keys(SECTIONS) as Array<keyof typeof SECTIONS>)
  .map((key) => {
    const items = mine.filter((d) => d.section === key);
    if (key === "components") {
      const groups = CATEGORY_ORDER.map((cat) => ({
        key: cat,
        label: CATEGORY_LABELS[cat][lang],
        items: items.filter((d) => d.category === cat),
      })).filter((g) => g.items.length > 0);
      return { key, label: SECTIONS[key][lang], icon: SECTIONS[key].icon, groups, items: [] };
    }
    return { key, label: SECTIONS[key][lang], icon: SECTIONS[key].icon, groups: null, items };
  })
  .filter((s) => (s.groups ? s.groups.length > 0 : s.items.length > 0));

const flat = nav.flatMap((section) =>
  section.groups ? section.groups.flatMap((g) => g.items) : section.items,
);
const currentIndex = flat.findIndex((x) => x.id === activeId);
const prevPage = currentIndex > 0 ? flat[currentIndex - 1] : null;
const nextPage = currentIndex >= 0 && currentIndex < flat.length - 1 ? flat[currentIndex + 1] : null;
const prevLabel = lang === "zh" ? "上一页" : "Previous";
const nextLabel = lang === "zh" ? "下一页" : "Next";

const canonical = new URL(path, Astro.site);
const alternate = new URL(altPath, Astro.site);
const homePath = lang === "zh" ? "/" : "/en/";
const homeAlt = lang === "zh" ? "/en/" : "/";
const prefix = lang === "zh" ? "" : "/en";
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fef7ff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1c1b1e" />
    <title>{title} · M3E</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === "zh" ? "en" : "zh"} href={alternate} />
    <link rel="alternate" hreflang={lang === "zh" ? "zh-CN" : "en"} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={lang === "zh" ? canonical : alternate} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · M3E`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="preload" href="/fonts/roboto.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" href="/fonts/msymbols.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
      <link rel="stylesheet" href="/fonts/roboto.css" />
      <link rel="stylesheet" href="/fonts/msymbols.css" />
    </noscript>
    <script type="module" src="/m3e/all.min.js"></script>
    {script && <script type="module" src={`/js/${script}.js`}></script>}
  </head>
  <body class={showBottomNav ? "has-bottomnav" : ""}>
    <m3e-theme>
      <header class="docs-appbar">
        <m3e-app-bar>
          {
            isDetail && (
              <m3e-icon-button class="back-button" slot="leading" data-back aria-label={lang === "zh" ? "返回" : "Back"}>
                <m3e-icon name="arrow_back"></m3e-icon>
              </m3e-icon-button>
            )
          }
          <a slot="title" class="title" href={homePath} aria-label="M3E">
            <span class="title-text">M3E</span>
          </a>
          <span slot="trailing">
            <m3e-icon-button id="search-button" data-search-open aria-label={lang === "zh" ? "搜索" : "Search"}>
              <m3e-icon name="search"></m3e-icon>
            </m3e-icon-button>
            <m3e-icon-button id="github-button" aria-label={UI.github} href="https://github.com/matraic/m3e" target="_blank">
              <m3e-icon name="code"></m3e-icon>
            </m3e-icon-button>
            <m3e-tooltip for="github-button">{UI.github}</m3e-tooltip>
            <m3e-button variant="text" href={homeAlt}>{lang === "zh" ? "EN" : "中文"}</m3e-button>
          </span>
        </m3e-app-bar>
      </header>

      <div class="layout">
        

        <main class="main">
          <div class="content">
            <article class="prose" id="doc-content">
              <slot />
              {
                (prevPage || nextPage) && (
                  <nav class="page-nav" aria-label={lang === "zh" ? "翻页" : "Pagination"}>
                    {prevPage ? (
                      <a class="page-nav__item" href={prevPage.path}>
                        <span class="page-nav__dir">← {prevLabel}</span>
                        <span class="page-nav__title">{prevPage.title}</span>
                      </a>
                    ) : (
                      <span />
                    )}
                    {nextPage ? (
                      <a class="page-nav__item page-nav__item--next" href={nextPage.path}>
                        <span class="page-nav__dir">{nextLabel} →</span>
                        <span class="page-nav__title">{nextPage.title}</span>
                      </a>
                    ) : (
                      <span />
                    )}
                  </nav>
                )
              }
            </article>
            {
              toc && (
                <aside class="toc">
                  <m3e-toc for="doc-content" max-depth="3">
                    <span slot="overline">{lang === "zh" ? "本页目录" : "On this page"}</span>
                    <span slot="title">{title}</span>
                  </m3e-toc>
                </aside>
              )
            }
          </div>
        </main>
      </div>

      <!-- 手机 / 平板：底部导航（组件详情页隐藏） -->
      {showBottomNav && (
      <div class="bottomnav-wrap">
      <m3e-nav-bar class="docs-bottomnav" aria-label={UI.docs}>
        <m3e-nav-item href={`${prefix}/getting-started/overview/`} selected={currentSection === "getting-started" ? true : undefined}>
          <m3e-icon slot="icon" name="home"></m3e-icon>
          {lang === "zh" ? "概览" : "Overview"}
        </m3e-nav-item>
        <m3e-nav-item href={`${prefix}/components/`} selected={currentSection === "components" ? true : undefined}>
          <m3e-icon slot="icon" name="widgets"></m3e-icon>
          {lang === "zh" ? "组件" : "Components"}
        </m3e-nav-item>
        <m3e-nav-item href={`${prefix}/styles/color/`} selected={currentSection === "styles" ? true : undefined}>
          <m3e-icon slot="icon" name="palette"></m3e-icon>
          {lang === "zh" ? "样式" : "Styles"}
        </m3e-nav-item>
        <m3e-nav-item href={`${prefix}/frameworks/react/`} selected={currentSection === "frameworks" ? true : undefined}>
          <m3e-icon slot="icon" name="integration_instructions"></m3e-icon>
          {lang === "zh" ? "框架" : "Frameworks"}
        </m3e-nav-item>
        <m3e-nav-item data-bottom-action="toc">
          <m3e-icon slot="icon" name="list"></m3e-icon>
          {lang === "zh" ? "目录" : "Contents"}
        </m3e-nav-item>
      </m3e-nav-bar>
      </div>
      )}

      <!-- 手机：本页目录底部抽屉 -->
      <div class="docs-sheet" id="toc-sheet" hidden>
        <div class="docs-sheet__scrim" data-sheet-close></div>
        <div class="docs-sheet__panel" role="dialog" aria-modal="true" aria-label={lang === "zh" ? "本页目录" : "On this page"}>
          <div class="docs-sheet__handle" data-sheet-close></div>
          <p class="docs-sheet__title">{lang === "zh" ? "本页目录" : "On this page"}</p>
          <nav class="docs-sheet__list">
            {headings.map((h) => (
              <a
                href={`#${h.slug}`}
                data-sheet-close
                style={`padding-inline-start:${(Math.max(h.depth, 2) - 1) * 14 + 16}px`}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </div>
      </div>
      <div class="docs-search" id="search" hidden>
        <div class="docs-search__panel" role="dialog" aria-modal="true" aria-label={lang === "zh" ? "搜索" : "Search"}>
          <div class="docs-search__bar">
            <m3e-icon name="search"></m3e-icon>
            <input
              id="search-input"
              type="search"
              autocomplete="off"
              placeholder={lang === "zh" ? "搜索组件、样式、指南…" : "Search components, styles, guides…"} />
            <button type="button" class="demo-btn" data-search-close aria-label={lang === "zh" ? "关闭" : "Close"}>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>
          <div class="docs-search__results" id="search-results"></div>
        </div>
      </div>
    </m3e-theme>

    <script is:inline>
  (function () {
    // ===== 全局事件委托：只安装一次，ClientRouter 导航后依然有效 =====
    if (!window.__m3eDocsBound) {
      window.__m3eDocsBound = true;
      var pagefindMod = null;

      var closeSearch = function () {
        var el = document.querySelector("#search");
        if (el) el.setAttribute("hidden", "");
      };

      document.addEventListener("click", async function (e) {
        // demo 块：查看代码 / 复制
        var demoBtn = e.target.closest("[data-demo-action]");
        if (demoBtn) {
          var demo = demoBtn.closest(".demo");
          var code = demo && demo.querySelector(".demo-code");
          if (code) {
            var action = demoBtn.getAttribute("data-demo-action");
            if (action === "toggle") {
              code.hidden = !code.hidden;
              demo.classList.toggle("code-open", !code.hidden);
              demoBtn.setAttribute("aria-expanded", String(!code.hidden));
              if (!code.hidden) demo.scrollIntoView({ block: "nearest" });
            } else if (action === "copy") {
              var codeEl = code.querySelector("code");
              var text = codeEl ? codeEl.innerText : "";
              try {
                await navigator.clipboard.writeText(text);
                demoBtn.classList.add("copied");
                setTimeout(function () { demoBtn.classList.remove("copied"); }, 1200);
              } catch (err) {}
            }
          }
          return;
        }

        // 底部导航：目录 -> 打开抽屉
        var bottomAction = e.target.closest("[data-bottom-action]");
        if (bottomAction) {
          if (bottomAction.getAttribute("data-bottom-action") === "toc") {
            var sheet = document.querySelector("#toc-sheet");
            if (sheet) sheet.removeAttribute("hidden");
          }
          return;
        }

        // 关闭抽屉
        if (e.target.closest("[data-sheet-close]")) {
          var sheetEl = document.querySelector("#toc-sheet");
          if (sheetEl) sheetEl.setAttribute("hidden", "");
          return;
        }

        // 返回
        if (e.target.closest("[data-back]")) { history.back(); return; }

        // 打开搜索（懒加载 pagefind 索引）
        if (e.target.closest("[data-search-open]")) {
          var s = document.querySelector("#search");
          var si = document.querySelector("#search-input");
          if (s) s.removeAttribute("hidden");
          if (si) si.focus();
          if (!pagefindMod) {
            try {
              pagefindMod = await import("/pagefind/pagefind.js");
            } catch (err) {
              var sr = document.querySelector("#search-results");
              if (sr) sr.textContent = "搜索索引未构建（先运行 npm run build）";
            }
          }
          return;
        }

        // 关闭搜索
        if (e.target.closest("[data-search-close]")) { closeSearch(); return; }

        // 点击搜索遮罩关闭
        var searchEl = document.querySelector("#search");
        if (searchEl && e.target === searchEl) { closeSearch(); return; }

        // 正文代码块复制按钮（动态创建，委托处理）
        var copyBtn = e.target.closest(".code-copy");
        if (copyBtn) {
          var wrap = copyBtn.closest(".code-wrap");
          var pre = wrap && wrap.querySelector("pre");
          if (pre) {
            var pc = pre.querySelector("code");
            var codeText = pc ? pc.innerText : pre.innerText;
            try {
              await navigator.clipboard.writeText(codeText);
              copyBtn.classList.add("copied");
              setTimeout(function () { copyBtn.classList.remove("copied"); }, 1200);
            } catch (err) {}
          }
        }
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeSearch();
        if (e.key === "/" && e.target === document.body) {
          e.preventDefault();
          var opener = document.querySelector("[data-search-open]");
          if (opener) opener.click();
          return;
        }
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        var t = e.target;
        if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
        // 翻页链接懒查询，保证 ClientRouter 导航后始终拿到当前页的链接
        var prevItem = document.querySelector(".page-nav__item:not(.page-nav__item--next)");
        var nextItem = document.querySelector(".page-nav__item--next");
        if (e.key === "ArrowLeft" && prevItem) location.assign(prevItem.getAttribute("href"));
        else if (e.key === "ArrowRight" && nextItem) location.assign(nextItem.getAttribute("href"));
      });

      // 搜索输入（input 事件冒泡，委托处理）
      document.addEventListener("input", async function (e) {
        var input = e.target;
        if (!input || input.id !== "search-input") return;
        var searchResults = document.querySelector("#search-results");
        if (!pagefindMod || !searchResults) return;
        var q = input.value.trim();
        if (!q) { searchResults.replaceChildren(); return; }
        var res = await pagefindMod.search(q);
        var items = await Promise.all(res.results.slice(0, 12).map(function (r) { return r.data(); }));
        searchResults.replaceChildren.apply(searchResults, items.map(function (i) {
          var a = document.createElement("a");
          a.href = i.url;
          var t = document.createElement("strong");
          t.textContent = (i.meta && i.meta.title) ? i.meta.title : i.url;
          var x = document.createElement("span");
          x.innerHTML = i.excerpt;
          a.append(t, x);
          a.addEventListener("click", closeSearch);
          return a;
        }));
      });
    }

    // ===== 每页 DOM 增强：正文代码块包一层并加复制按钮 =====
    function initDocsPage() {
      var zh = document.documentElement.lang.indexOf("zh") === 0;
      var copyLabel = zh ? "复制代码" : "Copy code";
      var copySvg = '<svg class="icon icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';
      var checkSvg = '<svg class="icon icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';
      document.querySelectorAll(".prose .astro-code").forEach(function (pre) {
        if (pre.closest(".demo")) return;
        if (pre.closest(".code-wrap")) return; // 已处理过（幂等）
        var wrap = document.createElement("div");
        wrap.className = "code-wrap";
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);
        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "code-copy";
        btn.setAttribute("aria-label", copyLabel);
        btn.innerHTML = copySvg + checkSvg;
        wrap.appendChild(btn);
      });
    }

    // 首次加载与每次 ClientRouter 导航后各执行一次
    document.addEventListener("astro:page-load", initDocsPage);
    if (document.readyState !== "loading") initDocsPage();
  })();
</script>
  </body>
</html>
