---
import { getCollection } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";

interface Props {
  lang: "en" | "zh";
}

const { lang } = Astro.props;

const CATEGORY_ORDER = ["basics", "actions", "communication", "containment", "navigation", "selection"] as const;
const LABELS = {
  actions: { en: "Actions", zh: "操作" },
  communication: { en: "Communication", zh: "通信" },
  containment: { en: "Containment", zh: "容器" },
  navigation: { en: "Navigation", zh: "导航" },
  selection: { en: "Selection", zh: "选择" },
  basics: { en: "Basics", zh: "基础" },
} as const;

const T = {
  en: {
    h1: "Components",
    description: "Browse every M3E web component, grouped by category.",
  },
  zh: {
    h1: "组件",
    description: "按类别浏览 M3E 的全部 Web Components 组件。",
  },
}[lang];

const prefix = lang === "zh" ? "" : "/en";
const previews = import.meta.glob("../demos/**/*.html", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
// 专用缩略图：site/src/thumbs/<组件名>.html，一张图只讲一个组件
const thumbs = import.meta.glob("../thumbs/*.html", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
const compId = (id: string) => id.split("/").pop() ?? "";
const thumbFor = (id: string) =>
  thumbs[`../thumbs/${compId(id)}.html`] ??
  previews[`../demos/${lang}/components/${compId(id)}/0.html`] ??
  "";
const all = await getCollection("docs");
const mine = all
  .filter((d) => d.id.startsWith(`${lang}/`) && d.data.section === "components")
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const pathFor = (id: string) => `${prefix}/${id.split("/").slice(1).join("/")}/`;
const GROUP_DESC = {
  actions: { en: "Buttons, FABs and triggers that start an action.", zh: "触发操作的按钮与悬浮操作。" },
  communication: { en: "Badges, chips, snackbars and progress that communicate status.", zh: "徽章、芯片、消息条与进度等状态沟通组件。" },
  containment: { en: "Cards, dialogs, lists and panes that contain content.", zh: "承载内容的卡片、对话框、列表与面板。" },
  navigation: { en: "Bars, rails, menus and tabs for getting around.", zh: "应用栏、侧边栏、菜单与标签页等导航组件。" },
  selection: { en: "Checkboxes, sliders, selects and pickers for choosing values.", zh: "复选框、滑块、下拉与日期时间选择。" },
  basics: { en: "Icons, headings, shapes and theming foundations.", zh: "图标、标题、形状与主题等基础能力。" },
} as const;
const groups = CATEGORY_ORDER.map((cat) => ({
  key: cat,
  label: LABELS[cat][lang],
  desc: GROUP_DESC[cat][lang],
  items: mine.filter((d) => d.data.category === cat),
})).filter((g) => g.items.length > 0);
---

<DocsLayout
  lang={lang}
  title={T.h1}
  description={T.description}
  path={`${prefix}/components/`}
  altPath={`${lang === "en" ? "/zh" : ""}/components/`}
  toc={false}
>
  <h1>{T.h1}</h1>
  <p>{T.description}</p>
  {
    groups.map((group) => (
      <section class="component-group">
        <h2>{group.label}</h2>
        <p>{group.desc}</p>
        <div class="cards">
          {group.items.map((d) => (
            <m3e-card variant="outlined" actionable href={pathFor(d.id)} class="component-card">
              <div slot="content">
                {thumbFor(d.id) && (
                  <div class="card-thumb" aria-hidden="true" set:html={thumbFor(d.id)} />
                )}
                <div class="card-body">
                  <span class="card-name">{d.data.title}</span>
                  <span class="card-desc">{d.data.summary || d.data.title}</span>
                </div>
              </div>
            </m3e-card>
          ))}
        </div>
      </section>
    ))
  }
</DocsLayout>
