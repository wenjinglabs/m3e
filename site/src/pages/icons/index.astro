---
import DocsLayout from "../../layouts/DocsLayout.astro";
import iconNames from "../../data/icon-names.json";

const lang = "zh";
const T = {
  zh: {
    h1: "图标",
    description: "浏览全部 Material Symbols 图标，点击图标复制名称。",
    searchPlaceholder: "搜索图标…（英文）",
    prev: "上一页",
    next: "下一页",
  },
  en: {
    h1: "Icons",
    description: "Browse all Material Symbols icons. Click an icon to copy its name.",
    searchPlaceholder: "Search icons…",
    prev: "Previous",
    next: "Next",
  },
}[lang]!;
const namesJson = JSON.stringify(iconNames);
---

<DocsLayout
  lang={lang}
  title={T.h1}
  description={T.description}
  path="/icons/"
  altPath="/en/icons/"
  toc={false}
  fullwidth
>
  <div class="icon-gallery" data-icon-gallery data-names={namesJson}>
    <div class="icon-gallery__head">
      <h1>{T.h1}</h1>
      <p>{T.description}</p>
      <div class="icon-gallery__bar">
        <m3e-icon name="search"></m3e-icon>
        <input
          class="icon-gallery__input"
          type="search"
          autocomplete="off"
          placeholder={T.searchPlaceholder}
          aria-label={T.searchPlaceholder}
        />
        <span class="icon-gallery__count" data-icon-count></span>
      </div>
    </div>
    <div class="icon-gallery__grid" data-icon-grid></div>
    <div class="icon-gallery__pager">
      <m3e-icon-button data-page-prev aria-label={T.prev} disabled>
        <m3e-icon name="chevron_left"></m3e-icon>
      </m3e-icon-button>
      <span class="icon-gallery__pageinfo" data-page-info></span>
      <m3e-icon-button data-page-next aria-label={T.next} disabled>
        <m3e-icon name="chevron_right"></m3e-icon>
      </m3e-icon-button>
    </div>
    <p class="icon-gallery__empty" data-icon-empty hidden>没有匹配的图标 / No matching icons</p>
  </div>
</DocsLayout>

<script>
  const PAGE_SIZE = 500;

  function makeCell(name: string): HTMLElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "icon-cell";
    btn.dataset.icon = name;
    btn.title = name;
    const icon = document.createElement("m3e-icon");
    icon.setAttribute("name", name);
    const label = document.createElement("span");
    label.className = "icon-cell__name";
    label.textContent = name;
    btn.append(icon, label);
    return btn;
  }

  function initIconGallery(root: HTMLElement) {
    if ((root as any).__bound) return;
    (root as any).__bound = true;
    const names: string[] = JSON.parse(root.dataset.names || "[]");
    const input = root.querySelector<HTMLInputElement>(".icon-gallery__input");
    const grid = root.querySelector<HTMLElement>("[data-icon-grid]");
    const empty = root.querySelector<HTMLElement>("[data-icon-empty]");
    const count = root.querySelector<HTMLElement>("[data-icon-count]");
    const info = root.querySelector<HTMLElement>("[data-page-info]");
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-page-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-page-next]");
    if (!input || !grid || !prevBtn || !nextBtn) return;

    let list: string[] = names;
    let page = 1;
    const pages = () => Math.max(1, Math.ceil(list.length / PAGE_SIZE));

    const copy = async (name: string, btn: HTMLElement) => {
      try {
        if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(name);
        else {
          const ta = document.createElement("textarea");
          ta.value = name;
          ta.style.cssText = "position:fixed;opacity:0";
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          ta.remove();
        }
        btn.classList.add("copied");
        setTimeout(() => btn.classList.remove("copied"), 1200);
      } catch {}
    };

    grid.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(".icon-cell");
      if (btn) copy(btn.dataset.icon || "", btn);
    });

    const renderPage = () => {
      const totalPages = pages();
      page = Math.min(Math.max(1, page), totalPages);
      const start = (page - 1) * PAGE_SIZE;
      const slice = list.slice(start, start + PAGE_SIZE);
      const frag = document.createDocumentFragment();
      for (const n of slice) frag.appendChild(makeCell(n));
      grid.replaceChildren(frag);
      grid.scrollTop = 0;
      if (info) info.textContent = `${page} / ${totalPages}`;
      prevBtn.disabled = page <= 1;
      nextBtn.disabled = page >= totalPages;
      if (count) count.textContent = `${list.length} / ${names.length}`;
      if (empty) empty.hidden = list.length > 0;
      if (!list.length) grid.replaceChildren();
    };

    const goto = (n: number) => {
      page = n;
      renderPage();
    };

    prevBtn.addEventListener("click", () => goto(page - 1));
    nextBtn.addEventListener("click", () => goto(page + 1));

    let timer = -1;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const q = input.value.trim().toLowerCase();
        list = q ? names.filter((n) => n.includes(q)) : names;
        goto(1);
      }, 120);
    });

    renderPage();
  }

  const boot = () => {
    const root = document.querySelector<HTMLElement>("[data-icon-gallery]");
    if (root) initIconGallery(root);
  };
  document.addEventListener("astro:page-load", boot);
  if (document.readyState !== "loading") boot();
  else document.addEventListener("DOMContentLoaded", boot);
</script>

<style is:global>
  .icon-gallery {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - 96px);
  }
  .icon-gallery__head h1 {
    margin: 0 0 4px;
  }
  .icon-gallery__head > p {
    margin: 0 0 14px;
    color: var(--md-sys-color-on-surface-variant, #49454f);
  }
  .icon-gallery__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 480px;
    padding: 12px 18px;
    border: 1px solid var(--md-sys-color-outline-variant, #cac4d0);
    border-radius: 999px;
    background: var(--md-sys-color-surface-container-lowest, #fff);
    margin-block: 0 14px;
  }
  .icon-gallery__input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    font: inherit;
    outline: none;
    color: var(--md-sys-color-on-surface, #1c1b1e);
  }
  .icon-gallery__count {
    font-size: 0.8rem;
    color: var(--md-sys-color-on-surface-variant, #49454f);
    white-space: nowrap;
  }
  /* 图标列表独立滚动，搜索栏与分页栏固定 */
  .icon-gallery__grid {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    grid-auto-rows: max-content;
    gap: 8px;
    align-content: start;
    padding-inline-end: 4px;
  }
  .icon-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 6px 10px;
    border: 1px solid transparent;
    border-radius: 12px;
    background: none;
    cursor: pointer;
    color: var(--md-sys-color-on-surface, #1c1b1e);
    font: inherit;
  }
  .icon-cell:hover {
    background: var(--md-sys-color-surface-container-low, #f7f2fa);
    border-color: var(--md-sys-color-outline-variant, #cac4d0);
  }
  .icon-cell m3e-icon {
    --m3e-icon-size: 40px;
    font-size: 40px;
  }
  .icon-cell__name {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.7rem;
    color: var(--md-sys-color-on-surface-variant, #49454f);
  }
  .icon-cell.copied {
    background: var(--md-sys-color-secondary-container, #e8def8);
  }
  .icon-gallery__pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding-block-start: 10px;
  }
  .icon-gallery__pageinfo {
    font-size: 0.9rem;
    color: var(--md-sys-color-on-surface-variant, #49454f);
    min-width: 72px;
    text-align: center;
  }
  .icon-gallery__empty {
    color: var(--md-sys-color-on-surface-variant, #49454f);
  }
</style>
